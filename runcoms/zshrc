#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Customize to your needs..#
export LC_ALL=en_GB.UTF-8
export GOPATH=$HOME/workspace
export PATH=$PATH:$GOPATH/bin:/usr/local/opt/go/libexec/bin


if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [[ -f /home/$USER/.userrc ]]; then
    source ~/.userrc
fi

export AWS_PROFILE=smartgrade_administrator
export AWS_DEFAULT_REGION=eu-west-2

# Pi
export PATH="$HOME/.local/bin:$PATH"
alias update='sudo apt update -y && sudo apt upgrade -y && sudo apt autoremove -y && sudo apt clean -y'

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

# WSLg X11 display (for GUI apps like kdenlive)
export DISPLAY=:0

# One tmux session per terminal tab (replaces prezto's tmux auto-start, which
# attached every tab to the same session). -A attaches instead of failing if a
# session with this name somehow already exists, so exec can never drop the tab.
if [[ -o interactive && -z "$TMUX" && -z "$EMACS" && -z "$VIM" ]] && (( $+commands[tmux] )); then
  exec tmux new-session -A -s "tab-$$"
fi
